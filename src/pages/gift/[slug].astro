---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { CURATED_CARDS, getCardBySlug } from '../../data';

const { slug } = Astro.params;
const card = getCardBySlug(slug);

if (!card) {
  throw new Error('Gift detail page not found');
}

const title = `${card.title} | GiftIdeaFor`;
const description = `${card.description} Explore ${card.picksCount} curated gift picks for ${card.title.toLowerCase()}.`;
const canonical = `https://giftideaforx.com/gift/${slug}`;
---

<SiteLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "${card.title}",
      "description": "${card.description}",
      "url": "${canonical}",
      "isPartOf": {
        "@type": "WebSite",
        "name": "GiftIdeaFor",
        "url": "https://giftideaforx.com/"
      }
    }
  </script>

  <article class="max-w-5xl mx-auto py-12 md:py-18">
    <div class="mb-8 text-sm uppercase tracking-[0.25em] text-[#1A1A1A]/60">
      Gift guide
    </div>

    <header class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center bg-white border border-black/5 p-6 md:p-8 mb-8">
      <div class="md:col-span-4 overflow-hidden border border-black/5 bg-[#FAF9F6]">
        <img src={card.image} alt={card.title} class="w-full h-72 md:h-80 object-cover" referrerpolicy="no-referrer" />
      </div>

      <div class="md:col-span-8 space-y-5">
        <span class="inline-block px-3 py-1 bg-[#E2D1C3] text-[#1A1A1A] text-[9px] font-bold uppercase tracking-widest rounded-none">
          {card.picksCount} Picks
        </span>
        <h1 class="font-serif text-[34px] md:text-[48px] leading-none text-[#1A1A1A] font-light italic">
          {card.title}
        </h1>
        <p class="text-[#1A1A1A]/75 text-[15px] leading-relaxed max-w-2xl">
          {card.description}
        </p>

        <div class="flex flex-wrap gap-2">
          {card.tags.map((tag) => (
            <span class="bg-black/5 text-[#1A1A1A] text-[10px] uppercase tracking-[0.18em] font-bold px-3 py-1.5">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {card.items.map((item) => (
        <div class="bg-white border border-black/5 p-5 md:p-6 shadow-[rgba(0,0,0,0.02)_0px_10px_25px_0px]">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h2 class="font-serif text-[22px] md:text-[26px] text-[#1A1A1A] font-light italic leading-tight">
              {item.name}
            </h2>
            <span class="font-serif text-[20px] text-[#1A1A1A] whitespace-nowrap">
              {item.price}
            </span>
          </div>

          <p class="text-[#1A1A1A]/70 text-[14px] leading-relaxed mb-5">
            {item.description}
          </p>

          <div class="flex items-center gap-3 pt-4 border-t border-black/5">
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 flex-1 bg-[#1A1A1A] text-white px-4 py-3 text-[10px] font-bold uppercase tracking-[0.18em] no-underline hover:bg-black/85 transition-all"
            >
              View product
            </a>
          </div>
        </div>
      ))}
    </div>
  </article>
</SiteLayout>
